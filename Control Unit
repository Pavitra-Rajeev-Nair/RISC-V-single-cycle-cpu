module control_unit (
    input  wire [6:0] opcode,

    output reg        reg_write,
    output reg        alu_src,
    output reg        mem_read,
    output reg        mem_write,
    output reg        mem_to_reg,
    output reg        branch,
    output reg        jump,
    output reg        jalr,
    output reg [1:0]  alu_op
);

    // ALU operation categories
    localparam ALU_RTYPE = 2'b00;
    localparam ALU_ITYPE = 2'b01;
    localparam ALU_BRANCH = 2'b10;
    localparam ALU_LS = 2'b11;

    always @(*) begin

        // Default values
        reg_write = 1'b0;
        alu_src   = 1'b0;
        mem_read  = 1'b0;
        mem_write = 1'b0;
        mem_to_reg = 1'b0;
        branch    = 1'b0;
        jump      = 1'b0;
        jalr      = 1'b0;
        alu_op    = ALU_RTYPE;


        case (opcode)

            // --------------------------------
            // R-TYPE
            // ADD, SUB, AND, OR, XOR, SLT
            // --------------------------------

            7'b0110011: begin

                reg_write = 1'b1;
                alu_src   = 1'b0;
                alu_op    = ALU_RTYPE;

            end


            // --------------------------------
            // I-TYPE ALU
            // ADDI, ANDI, ORI, XORI, SLTI
            // --------------------------------

            7'b0010011: begin

                reg_write = 1'b1;
                alu_src   = 1'b1;
                alu_op    = ALU_ITYPE;

            end


            // --------------------------------
            // LOAD
            // LW
            // --------------------------------

            7'b0000011: begin

                reg_write = 1'b1;
                alu_src   = 1'b1;
                mem_read  = 1'b1;
                mem_to_reg = 1'b1;
                alu_op    = ALU_LS;

            end


            // --------------------------------
            // STORE
            // SW
            // --------------------------------

            7'b0100011: begin

                alu_src   = 1'b1;
                mem_write = 1'b1;
                alu_op    = ALU_LS;

            end


            // --------------------------------
            // BRANCH
            // BEQ, BNE
            // --------------------------------

            7'b1100011: begin

                alu_src = 1'b0;
                branch  = 1'b1;
                alu_op  = ALU_BRANCH;

            end


            // --------------------------------
            // JAL
            // --------------------------------

            7'b1101111: begin

                reg_write = 1'b1;
                jump      = 1'b1;

            end


            // --------------------------------
            // JALR
            // --------------------------------

            7'b1100111: begin

                reg_write = 1'b1;
                jump      = 1'b1;
                jalr      = 1'b1;
                alu_src   = 1'b1;

            end


            // --------------------------------
            // LUI
            // --------------------------------

            7'b0110111: begin

                reg_write = 1'b1;

            end


            // --------------------------------
            // AUIPC
            // --------------------------------

            7'b0010111: begin

                reg_write = 1'b1;

            end


            default: begin

                reg_write = 1'b0;
                alu_src   = 1'b0;
                mem_read  = 1'b0;
                mem_write = 1'b0;
                mem_to_reg = 1'b0;
                branch    = 1'b0;
                jump      = 1'b0;
                jalr      = 1'b0;
                alu_op    = ALU_RTYPE;

            end

        endcase

    end

endmodule
