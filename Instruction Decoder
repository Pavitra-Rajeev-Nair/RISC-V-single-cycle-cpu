module instruction_decoder (
    input  wire [31:0] instruction,

    output wire [6:0]  opcode,
    output wire [4:0]  rd,
    output wire [4:0]  rs1,
    output wire [4:0]  rs2,
    output wire [2:0]  funct3,
    output wire [6:0]  funct7,

    output reg  [2:0]  instr_type,
    output reg  [31:0] immediate
);

    // --------------------------------
    // Extract common instruction fields
    // --------------------------------

    assign opcode = instruction[6:0];
    assign rd     = instruction[11:7];
    assign funct3 = instruction[14:12];
    assign rs1    = instruction[19:15];
    assign rs2    = instruction[24:20];
    assign funct7 = instruction[31:25];


    // --------------------------------
    // Instruction type definitions
    // --------------------------------

    localparam R_TYPE = 3'b000;
    localparam I_TYPE = 3'b001;
    localparam S_TYPE = 3'b010;
    localparam B_TYPE = 3'b011;
    localparam U_TYPE = 3'b100;
    localparam J_TYPE = 3'b101;


    // --------------------------------
    // Decode instruction
    // --------------------------------

    always @(*) begin

        instr_type = R_TYPE;
        immediate  = 32'b0;

        case (opcode)

            // -------------------------
            // R-type
            // ADD, SUB, AND, OR, XOR
            // SLT ...
            // -------------------------

            7'b0110011: begin

                instr_type = R_TYPE;

                immediate = 32'b0;

            end


            // -------------------------
            // I-type ALU
            // ADDI, ANDI, ORI ...
            // -------------------------

            7'b0010011: begin

                instr_type = I_TYPE;

                immediate = {{20{instruction[31]}},
                             instruction[31:20]};

            end


            // -------------------------
            // I-type LOAD
            // LW
            // -------------------------

            7'b0000011: begin

                instr_type = I_TYPE;

                immediate = {{20{instruction[31]}},
                             instruction[31:20]};

            end


            // -------------------------
            // I-type JALR
            // -------------------------

            7'b1100111: begin

                instr_type = I_TYPE;

                immediate = {{20{instruction[31]}},
                             instruction[31:20]};

            end


            // -------------------------
            // S-type
            // SW
            // -------------------------

            7'b0100011: begin

                instr_type = S_TYPE;

                immediate = {{20{instruction[31]}},
                             instruction[31:25],
                             instruction[11:7]};

            end


            // -------------------------
            // B-type
            // BEQ, BNE ...
            // -------------------------

            7'b1100011: begin

                instr_type = B_TYPE;

                immediate = {{19{instruction[31]}},
                             instruction[31],
                             instruction[7],
                             instruction[30:25],
                             instruction[11:8],
                             1'b0};

            end


            // -------------------------
            // U-type
            // LUI
            // -------------------------

            7'b0110111: begin

                instr_type = U_TYPE;

                immediate = {instruction[31:12],
                             12'b0};

            end


            // -------------------------
            // U-type
            // AUIPC
            // -------------------------

            7'b0010111: begin

                instr_type = U_TYPE;

                immediate = {instruction[31:12],
                             12'b0};

            end


            // -------------------------
            // J-type
            // JAL
            // -------------------------

            7'b1101111: begin

                instr_type = J_TYPE;

                immediate = {{11{instruction[31]}},
                             instruction[31],
                             instruction[19:12],
                             instruction[20],
                             instruction[30:21],
                             1'b0};

            end


            default: begin

                instr_type = R_TYPE;
                immediate  = 32'b0;

            end

        endcase

    end

endmodule
