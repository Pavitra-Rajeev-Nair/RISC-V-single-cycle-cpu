`timescale 1ns/1ps

module riscv_cpu_tb;

    reg clk;
    reg reset;

    // =====================================================
    // Instantiate CPU
    // =====================================================

    riscv_cpu DUT (
        .clk(clk),
        .reset(reset)
    );


    // =====================================================
    // Clock generation
    // 10 ns clock period
    // =====================================================

    initial begin
        clk = 0;

        forever #5 clk = ~clk;
    end


    // =====================================================
    // Test
    // =====================================================

    initial begin

        // Reset CPU
        reset = 1;

        #10;

        reset = 0;


        // =================================================
        // Program
        //
        // ADDI x1, x0, 5
        // ADDI x2, x0, 10
        // ADD  x3, x1, x2
        // SUB  x4, x2, x1
        // =================================================

        DUT.IMEM.memory[0] = 32'h00500093;
        DUT.IMEM.memory[1] = 32'h00A00113;
        DUT.IMEM.memory[2] = 32'h002081B3;
        DUT.IMEM.memory[3] = 32'h40110233;


        // Let CPU execute instructions
        #50;


        // =================================================
        // Display results
        // =================================================

        $display("----------------------------------");
        $display("       RISC-V CPU TEST");
        $display("----------------------------------");

        $display("x1 = %d", DUT.REGFILE.registers[1]);
        $display("x2 = %d", DUT.REGFILE.registers[2]);
        $display("x3 = %d", DUT.REGFILE.registers[3]);
        $display("x4 = %d", DUT.REGFILE.registers[4]);

        $display("----------------------------------");


        $finish;

    end

endmodule
