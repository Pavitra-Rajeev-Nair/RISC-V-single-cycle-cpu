module alu (
    input  wire [31:0] a,
    input  wire [31:0] b,

    input  wire [3:0] alu_control,

    output reg  [31:0] result,
    output wire        zero
);

    // ALU operation codes

    localparam ALU_ADD = 4'b0000;
    localparam ALU_SUB = 4'b0001;
    localparam ALU_AND = 4'b0010;
    localparam ALU_OR  = 4'b0011;
    localparam ALU_XOR = 4'b0100;
    localparam ALU_SLT = 4'b0101;


    always @(*) begin

        case (alu_control)

            // Addition
            ALU_ADD:
                result = a + b;

            // Subtraction
            ALU_SUB:
                result = a - b;

            // AND
            ALU_AND:
                result = a & b;

            // OR
            ALU_OR:
                result = a | b;

            // XOR
            ALU_XOR:
                result = a ^ b;

            // Set Less Than
            ALU_SLT:
                result = ($signed(a) < $signed(b)) ? 32'd1 : 32'd0;

            default:
                result = 32'b0;

        endcase

    end


    // Used mainly for BEQ
    assign zero = (result == 32'b0);

endmodule
